# Raqeem Control Center — environment variables (server-side only)
#
# Copy to .env.local for local development. Never commit secrets.

# Data source: mock (default) or odoo
CONTROL_CENTER_DATA_SOURCE=mock

# Odoo read-only API base URL (required when CONTROL_CENTER_DATA_SOURCE=odoo)
# Example: http://127.0.0.1:8094 or https://api-control-dev.raqeem.ma
RAQEEM_PLATFORM_API_BASE_URL=

# Optional bearer token — sent server-side only, never exposed to the browser
RAQEEM_PLATFORM_API_TOKEN=

# ---------------------------------------------------------------------------
# Platform operator auth (single shared operator — separate from Knowledge)
# ---------------------------------------------------------------------------
CONTROL_CENTER_AUTH_USERNAME=
CONTROL_CENTER_AUTH_PASSWORD=
CONTROL_CENTER_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Knowledge multi-user auth (Odoo is identity / roles / MFA source)
# ---------------------------------------------------------------------------
# Base URL for Control Center Odoo Knowledge Auth API (no trailing slash)
RAQEEM_CONTROL_ODOO_BASE_URL=

# Long random secret (≥32 chars). Used for session versioning / config gate.
RAQEEM_KNOWLEDGE_SESSION_SECRET=

# 32-byte key for JWE A256GCM session encryption.
# Preferred: base64url / base64 / 64-char hex. Passphrases ≥32 chars are hashed.
RAQEEM_KNOWLEDGE_SESSION_ENCRYPTION_KEY=

# Session TTL in seconds (default 28800 = 8 hours)
RAQEEM_KNOWLEDGE_SESSION_TTL_SECONDS=28800
